      "description": "1 If rain was reported"
    },
    {
      "@type": "PropertyValue",
      "name": "Fog",
      "description": "1 If fog was reported"
    },
    {
      "@type": "PropertyValue",
      "name": "Snow type",
      "description": "1 If snow was reported",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@type": "DefinedTerm",
          "name": "snow"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Thunder",
      "description": "1 If thunder and or lightning was reported"
    },
    {
      "@type": "PropertyValue",
      "name": "Hail",
      "description": "1 If hail was reported"
    },
    {
      "@type": "PropertyValue",
      "name": "Sea ice",
      "description": "1 If sea-ice or icebergs were reported",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@id": "http://purl.obolibrary.org/obo/ENVO_00002200",
          "@type": "DefinedTerm",
          "identifier": "http://purl.obolibrary.org/obo/ENVO_00002200",
          "name": "sea ice",
          "url": "http://purl.obolibrary.org/obo/ENVO_00002200"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Identification",
      "description": "CLIWOC 2.1 line number"
    }
