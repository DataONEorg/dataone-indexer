  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "DATE/TIME",
      "url": "http://en.wikipedia.org/wiki/ISO_8601",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@id": "http://qudt.org/1.1/vocab/quantity#Time",
          "@type": "DefinedTerm",
          "identifier": "http://qudt.org/1.1/vocab/quantity#Time",
          "name": "Time",
          "alternateName": "T",
          "url": "http://dbpedia.org/resource/Time"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "LATITUDE",
      "url": "http://en.wikipedia.org/wiki/ISO_6709"
    },
    {
      "@type": "PropertyValue",
      "name": "LONGITUDE",
      "url": "http://en.wikipedia.org/wiki/ISO_6709"
    },
    {
      "@type": "PropertyValue",
      "name": "Wind direction",
      "unitText": "deg",
      "description": "Wind direction (from which the wind is blowing) in whole degrees from: 1-360; 361 = calm, 362 = variable. It is not clear from many logbook entries whether the wind direction has been corrected for the magnetic variation (or declination). To avoid any misunderstanding, all winds from reports that included a valid position in the period 1750-1854 were corrected. All other wind directions are given without being corrected.",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": [
          {
            "@id": "http://qudt.org/1.1/vocab/quantity#Angle",
            "@type": "DefinedTerm",
            "identifier": "http://qudt.org/1.1/vocab/quantity#Angle",
            "name": "Angle",
            "url": "http://dbpedia.org/resource/Angle"
          },
          {
            "@id": "http://qudt.org/1.1/vocab/quantity#PlaneAngle",
            "@type": "DefinedTerm",
            "identifier": "http://qudt.org/1.1/vocab/quantity#PlaneAngle",
            "name": "Plane Angle",
            "url": "http://dbpedia.org/resource/Plane_angle"
          }
        ]
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Wind speed",
      "unitText": "m/s",
      "description": "calculated from the descriptive terms of wind force given in the observations",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": [
          {
            "@id": "http://qudt.org/1.1/vocab/quantity#LinearVelocity",
            "@type": "DefinedTerm",
            "identifier": "http://qudt.org/1.1/vocab/quantity#LinearVelocity",
            "name": "Linear Velocity",
            "url": "http://dbpedia.org/resource/Velocity"
          },
          {
            "@type": "DefinedTerm",
            "name": "wind speed"
          }
        ]
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Landmark",
      "description": "Name of first landmark"
    },
    {
      "@type": "PropertyValue",
      "name": "Bearing",
      "description": "Bearing of the first landmark"
    },
    {
      "@type": "PropertyValue",
      "name": "Distance to landmark",
      "unitText": "arbitrary units",
      "description": "Distance to the first landmark",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@id": "urn:obo:pato:term:0000040",
          "@type": "DefinedTerm",
          "identifier": "urn:obo:pato:term:0000040",
          "name": "distance",
          "url": "http://purl.obolibrary.org/obo/PATO_0000040"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "-",
      "description": "1 If position is considered to be coastal (in port or near coastal disturbances)",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@type": "DefinedTerm",
          "name": "Molar Concentration"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Course",
      "description": "Course of the ship during the past 24 hours"
    },
    {
      "@type": "PropertyValue",
      "name": "Distance",
      "unitText": "arbitrary units",
      "description": "Distance travelled during the previous 24 hours",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": {
          "@id": "urn:obo:pato:term:0000040",
          "@type": "DefinedTerm",
          "identifier": "urn:obo:pato:term:0000040",
          "name": "distance",
          "url": "http://purl.obolibrary.org/obo/PATO_0000040"
        }
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Declination",
      "unitText": "deg",
      "description": "It is generally accepted by the CLIWOC team that the wind directions, reported by the ships officers, were relative to the magnetic North direction. Navigators were well aware of the difference between the true and magnetic north direction, but the compasses (we assumed that the bearing-compasses were mostly used for determining the wind direction) were not always adjusted. Therefore the wind direction has to be corrected. The magnetic declination (or variation, as it is known on board ships) is given for the whole CLIWOC period (1750-1850) for every 5x5 degree square. The number was added to the wind direction to get the true wind direction.",
      "subjectOf": {
        "@type": "DefinedTermSet",
        "hasDefinedTerm": [
          {
            "@id": "http://qudt.org/1.1/vocab/quantity#Angle",
            "@type": "DefinedTerm",
            "identifier": "http://qudt.org/1.1/vocab/quantity#Angle",
            "name": "Angle",
            "url": "http://dbpedia.org/resource/Angle"
          },
          {
            "@id": "http://qudt.org/1.1/vocab/quantity#PlaneAngle",
            "@type": "DefinedTerm",
            "identifier": "http://qudt.org/1.1/vocab/quantity#PlaneAngle",
            "name": "Plane Angle",
            "url": "http://dbpedia.org/resource/Plane_angle"
          }
        ]
      }
    },
    {
      "@type": "PropertyValue",
      "name": "Wind direction description",
      "description": "All reported wind directions on this day. The wind direction is the direction that points to where the wind comes from."
    },
    {
      "@type": "PropertyValue",
      "name": "Wind force description",
      "description": "All reported wind forces on this day"
    },
    {
      "@type": "PropertyValue",
      "name": "Present weather",
      "description": "Weather description"
    },
    {
      "@type": "PropertyValue",
      "name": "Precipitation description"
    },
    {
      "@type": "PropertyValue",
      "name": "Clearness"
    },
    {
